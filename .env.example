XRAYDENT_ENABLE_SEMANTIC=true
XRAYDENT_ENABLE_LLM=true
XRAYDENT_ALLOW_GENERAL_KNOWLEDGE=true
XRAYDENT_OFFLINE=true
XRAYDENT_RETRIEVAL_THRESHOLD=0.55
XRAYDENT_LLM_MODEL=Qwen/Qwen3-0.6B
XRAYDENT_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
XRAYDENT_ADAPTER_PATH=artifacts/adapter
XRAYDENT_SUPPORT_EMAIL=info@x-raydent.ru
